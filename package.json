{
  "name": "srv-desktop",
  "productName": "Sorvia Desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Sorvia çalışanları için Windows masaüstü çalışma alanı",
  "author": "Sorvia",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "build": {
    "appId": "net.sorvia.desktop",
    "productName": "Sorvia Desktop",
    "copyright": "© Sorvia",
    "publish": [
      {
        "provider": "generic",
        "url": "https://sorvia.net/api/desktop/update"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Sorvia-Desktop-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sorvia Desktop",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3",
    "@types/react-dom": "19.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "imapflow": "^2.9.1",
    "lucide-react": "^1.63.0",
    "mailparser": "^3.13.0",
    "motion": "^14.7.1",
    "nodemailer": "^10.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
